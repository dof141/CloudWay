# Docker Compose production configuration
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini
LLM_TIMEOUT=600

VITE_AMAP_WEB_KEY=your_amap_web_service_key
VITE_AMAP_WEB_JS_KEY=your_amap_javascript_key

XHS_COOKIE=your_xiaohongshu_cookie
XHS_CACHE_ENABLED=true
XHS_CACHE_FRESH_TTL_SECONDS=3600
XHS_CACHE_TTL_SECONDS=86400

# Optional Google Maps configuration
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=
